---
/**
 * The A ⇄ B switch in the header of every page.
 * A-side: Tianyou Ma (the academic pages, at /). B-side: Homological Alice (at /alice/).
 * It is a plain link to the matching page on the other side; MirrorTransition.astro adds the flip.
 * Colours come from the layout through --m-* custom properties.
 */
interface Props {
	/** The side this page is on. */
	side: 'A' | 'B';
	/** Where the switch goes: the matching page on the other side. */
	href: string;
}
const { side, href } = Astro.props;
const other = side === 'A' ? 'B-side: Homological Alice' : 'A-side: Tianyou Ma';
---

<a class:list={['mirror', `mirror-${side}`]} href={href} title={`Mirror to the ${other}`} aria-label={`Switch to the ${other}`}>
	<span class="m-a" aria-hidden="true">A</span>
	<span class="m-sym" aria-hidden="true">&#8644;</span>
	<span class="m-b" aria-hidden="true">B</span>
</a>

<style>
	.mirror {
		display: inline-flex;
		align-items: center;
		gap: 0.05rem;
		padding: 0.12rem;
		border: 1px solid var(--m-border, currentColor);
		border-radius: 999px;
		background: var(--m-bg, transparent);
		color: var(--m-fg, inherit);
		font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		-webkit-tap-highlight-color: transparent;
	}
	.mirror span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.5rem;
		height: 1.5rem;
		border-radius: 999px;
	}
	.mirror .m-sym {
		min-width: 0;
		padding: 0 0.15rem;
		font-weight: 400;
		transition: transform 0.25s ease;
	}
	.mirror-A .m-a,
	.mirror-B .m-b {
		background: var(--m-on-bg, currentColor);
		color: var(--m-on-fg, #fff);
	}
	.mirror:hover .m-sym,
	.mirror:focus-visible .m-sym {
		transform: scaleX(-1);
	}
	.mirror:focus-visible {
		outline: 2px solid var(--m-on-bg, currentColor);
		outline-offset: 2px;
	}
	@media (prefers-reduced-motion: reduce) {
		.mirror .m-sym {
			transition: none;
		}
	}
</style>
