---
/**
 * A page-by-page PDF reader for Notes. One page at a time, with buttons, the arrow keys and
 * swiping to turn pages, a page box to jump, and zoom. #page=N in the address opens that page.
 * PDF.js is loaded from cdnjs only on pages that use this component; without JavaScript the
 * reader falls back to a plain link to the PDF.
 */
interface Props {
	/** The PDF, usually under /files/notes/. */
	src: string;
	/** What the PDF is, for screen readers. */
	title: string;
}
const { src, title } = Astro.props;
---

<figure class="pdf-reader" data-src={src} data-title={title}>
	<div class="pdf-bar" role="toolbar" aria-label="PDF pages">
		<div class="pdf-nav">
			<button type="button" class="pdf-prev" aria-label="Previous page" disabled>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
			</button>
			<label class="pdf-count">
				<span class="sr-only">Page</span>
				<input class="pdf-page" type="number" inputmode="numeric" min="1" value="1" disabled />
				<span aria-hidden="true">/</span>
				<span class="pdf-total">–</span>
			</label>
			<button type="button" class="pdf-next" aria-label="Next page" disabled>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
			</button>
		</div>
		<div class="pdf-zoom" role="group" aria-label="Zoom">
			<button type="button" class="pdf-zoom-out" aria-label="Zoom out" disabled>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
			</button>
			<span class="pdf-zoom-val">Fit</span>
			<button type="button" class="pdf-zoom-in" aria-label="Zoom in" disabled>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
			</button>
		</div>
		<a class="pdf-download" href={src} download>Download PDF</a>
	</div>
	<div class="pdf-stage" tabindex="0" aria-label={`${title}: use the left and right arrow keys to turn pages`}>
		<canvas class="pdf-canvas" role="img" aria-label={`${title}, page 1`}></canvas>
		<p class="pdf-msg">Loading the PDF…</p>
	</div>
	<p class="pdf-live sr-only" aria-live="polite"></p>
	<noscript><p class="pdf-noscript"><a href={src}>Open the PDF</a></p></noscript>
</figure>

<script>
	// Keep this version pinned; the worker must be the same version as the library.
	const PDFJS_VERSION = '4.10.38';
	const CDN = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${PDFJS_VERSION}`;
	const ZOOMS = [1, 1.25, 1.5, 2, 2.5]; // multiples of "fit to width"

	type PdfDoc = { numPages: number; getPage(n: number): Promise<any> };
	let pdfjsPromise: Promise<any> | null = null;
	const loadPdfjs = () => {
		if (!pdfjsPromise) {
			pdfjsPromise = import(/* @vite-ignore */ `${CDN}/pdf.min.mjs`).then((lib) => {
				lib.GlobalWorkerOptions.workerSrc = `${CDN}/pdf.worker.min.mjs`;
				return lib;
			});
		}
		return pdfjsPromise;
	};

	const store = {
		get(key: string) {
			try {
				return localStorage.getItem(key);
			} catch {
				return null;
			}
		},
		set(key: string, value: string) {
			try {
				localStorage.setItem(key, value);
			} catch {}
		},
	};
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	async function setup(root: HTMLElement) {
		const src = root.dataset.src!;
		const title = root.dataset.title ?? 'PDF';
		const $ = <T extends Element>(sel: string) => root.querySelector(sel) as T;
		const stage = $<HTMLDivElement>('.pdf-stage');
		const canvas = $<HTMLCanvasElement>('.pdf-canvas');
		const msg = $<HTMLParagraphElement>('.pdf-msg');
		const live = $<HTMLParagraphElement>('.pdf-live');
		const input = $<HTMLInputElement>('.pdf-page');
		const total = $<HTMLSpanElement>('.pdf-total');
		const prev = $<HTMLButtonElement>('.pdf-prev');
		const next = $<HTMLButtonElement>('.pdf-next');
		const zoomIn = $<HTMLButtonElement>('.pdf-zoom-in');
		const zoomOut = $<HTMLButtonElement>('.pdf-zoom-out');
		const zoomVal = $<HTMLSpanElement>('.pdf-zoom-val');
		const key = `pdf-page:${src}`;

		let doc: PdfDoc;
		try {
			const pdfjs = await loadPdfjs();
			doc = await pdfjs.getDocument({ url: src }).promise;
		} catch (err) {
			console.error(err);
			msg.innerHTML = '';
			msg.append('The reader could not load this PDF. ');
			const a = document.createElement('a');
			a.href = src;
			a.textContent = 'Open it directly';
			msg.append(a, '.');
			return;
		}

		const n = doc.numPages;
		total.textContent = String(n);
		input.max = String(n);
		const fromHash = Number((location.hash.match(/page=(\d+)/) || [])[1]);
		let page = fromHash || Number(store.get(key)) || 1;
		page = Math.min(Math.max(1, page), n);
		let zoom = 0;
		let task: { cancel(): void; promise: Promise<void> } | null = null;
		let drawn = 0;

		const draw = async (dir = 0) => {
			const p = await doc.getPage(page);
			const base = p.getViewport({ scale: 1 });
			const fitWidth = stage.clientWidth;
			const cssScale = (fitWidth / base.width) * ZOOMS[zoom];
			const viewport = p.getViewport({ scale: cssScale });
			// Sharp on high-density screens, but cap the canvas size.
			const dpr = Math.min(window.devicePixelRatio || 1, 3, Math.sqrt(16e6 / (viewport.width * viewport.height)));
			task?.cancel();
			const off = document.createElement('canvas');
			off.width = Math.floor(viewport.width * dpr);
			off.height = Math.floor(viewport.height * dpr);
			const ctx = off.getContext('2d')!;
			task = p.render({ canvasContext: ctx, viewport, transform: dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : undefined });
			try {
				await task!.promise;
			} catch (e: any) {
				if (e?.name === 'RenderingCancelledException') return;
				throw e;
			}
			// Swap in the finished page at once, so a page never shows half drawn.
			canvas.width = off.width;
			canvas.height = off.height;
			canvas.style.width = `${Math.floor(viewport.width)}px`;
			canvas.style.height = `${Math.floor(viewport.height)}px`;
			canvas.getContext('2d')!.drawImage(off, 0, 0);
			canvas.setAttribute('aria-label', `${title}, page ${page} of ${n}`);
			stage.classList.toggle('zoomed', zoom > 0);
			if (dir && !reduceMotion) {
				canvas.classList.remove('turn-next', 'turn-prev');
				void canvas.offsetWidth;
				canvas.classList.add(dir > 0 ? 'turn-next' : 'turn-prev');
			}
			msg.hidden = true;
			drawn = page;
		};

		const update = (dir = 0) => {
			input.value = String(page);
			prev.disabled = page <= 1;
			next.disabled = page >= n;
			zoomOut.disabled = zoom <= 0;
			zoomIn.disabled = zoom >= ZOOMS.length - 1;
			zoomVal.textContent = zoom === 0 ? 'Fit' : `${Math.round(ZOOMS[zoom] * 100)}%`;
			store.set(key, String(page));
			history.replaceState(null, '', `#page=${page}`);
			live.textContent = `Page ${page} of ${n}`;
			draw(dir).catch((e) => console.error(e));
		};

		const go = (to: number) => {
			to = Math.min(Math.max(1, Math.round(to) || 1), n);
			if (to === page && drawn === page) return;
			const dir = Math.sign(to - page);
			page = to;
			update(dir);
			// If the top of the page has scrolled away, bring it back.
			const top = root.getBoundingClientRect().top;
			if (top < 0) root.scrollIntoView({ block: 'start', behavior: reduceMotion ? 'auto' : 'smooth' });
		};

		input.disabled = false;
		prev.addEventListener('click', () => go(page - 1));
		next.addEventListener('click', () => go(page + 1));
		input.addEventListener('change', () => go(Number(input.value)));
		zoomIn.addEventListener('click', () => {
			zoom = Math.min(zoom + 1, ZOOMS.length - 1);
			update();
		});
		zoomOut.addEventListener('click', () => {
			zoom = Math.max(zoom - 1, 0);
			update();
		});

		// Arrow keys turn pages, unless the reader is typing somewhere.
		document.addEventListener('keydown', (e) => {
			if (e.altKey || e.ctrlKey || e.metaKey) return;
			const t = e.target as HTMLElement;
			if (t.closest('input, textarea, select, [contenteditable]')) return;
			if (e.key === 'ArrowRight') go(page + 1);
			else if (e.key === 'ArrowLeft') go(page - 1);
			else return;
			e.preventDefault();
		});

		// Swipe left or right on a touch screen (only when not zoomed in, where dragging pans).
		let sx = 0;
		let sy = 0;
		stage.addEventListener('touchstart', (e) => {
			sx = e.touches[0].clientX;
			sy = e.touches[0].clientY;
		}, { passive: true });
		stage.addEventListener('touchend', (e) => {
			if (zoom > 0 || e.touches.length > 0) return;
			const dx = e.changedTouches[0].clientX - sx;
			const dy = e.changedTouches[0].clientY - sy;
			if (Math.abs(dx) > 50 && Math.abs(dx) > 1.5 * Math.abs(dy)) go(page + (dx < 0 ? 1 : -1));
		});

		// A link such as <a href="#page=3"> on the same page turns to that page.
		window.addEventListener('hashchange', () => {
			const to = Number((location.hash.match(/page=(\d+)/) || [])[1]);
			if (to && to !== page) go(to);
		});

		// Redraw at the new width when the window changes size.
		let lastWidth = stage.clientWidth;
		let timer: number | undefined;
		new ResizeObserver(() => {
			if (stage.clientWidth === lastWidth) return;
			lastWidth = stage.clientWidth;
			clearTimeout(timer);
			timer = window.setTimeout(() => draw().catch((e) => console.error(e)), 150);
		}).observe(stage);

		update();
	}

	document.querySelectorAll<HTMLElement>('.pdf-reader').forEach((el) => setup(el));
</script>

<style>
	/* Wider than the text column on large screens, so a page is easy to read. */
	.pdf-reader {
		--pdf-width: min(56rem, calc(100vw - 2.5rem));
		width: var(--pdf-width);
		margin: 1.5rem 0 2rem calc(50% - var(--pdf-width) / 2);
		font-family: var(--sans);
	}
	.pdf-bar {
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding: 0.5rem 0.25rem;
		background: var(--bg);
		border-bottom: 1px solid var(--hair);
		font-size: 0.9rem;
	}
	.pdf-nav,
	.pdf-zoom {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}
	.pdf-bar button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--hair);
		border-radius: 50%;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}
	.pdf-bar button:hover:not(:disabled) {
		background: var(--code-bg);
	}
	.pdf-bar button:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.pdf-count {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.pdf-page {
		width: 3.2em;
		padding: 0.2rem 0.3rem;
		border: 1px solid var(--hair);
		border-radius: 0.3rem;
		background: var(--bg);
		color: var(--ink);
		font: inherit;
		text-align: center;
	}
	.pdf-zoom-val {
		min-width: 3em;
		text-align: center;
		color: var(--muted);
		font-size: 0.8rem;
	}
	.pdf-download {
		font-size: 0.9rem;
	}
	.pdf-stage {
		position: relative;
		display: flex;
		justify-content: center;
		min-height: 20rem;
		padding: 1rem 0;
		overflow-x: hidden;
		outline: none;
	}
	.pdf-stage.zoomed {
		overflow-x: auto;
		justify-content: flex-start;
	}
	.pdf-stage:focus-visible {
		box-shadow: inset 0 0 0 2px var(--accent);
	}
	.pdf-canvas {
		display: block;
		flex: none;
		max-width: none;
		background: #fff;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(0, 0, 0, 0.04);
	}
	.pdf-canvas.turn-next {
		animation: pdf-in-next 0.22s ease-out;
	}
	.pdf-canvas.turn-prev {
		animation: pdf-in-prev 0.22s ease-out;
	}
	@keyframes pdf-in-next {
		from {
			opacity: 0.35;
			transform: translateX(14px);
		}
	}
	@keyframes pdf-in-prev {
		from {
			opacity: 0.35;
			transform: translateX(-14px);
		}
	}
	.pdf-msg {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.pdf-msg[hidden] {
		display: none;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
