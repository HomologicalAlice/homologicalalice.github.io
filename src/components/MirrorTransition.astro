---
/**
 * The page flips like a mirror when you cross between the A-side (/) and the B-side (/alice/).
 * Put this in the <head> of both layouts.
 *
 * Uses cross-document view transitions. Navigation inside one side gets no transition, and
 * browsers without support simply load the next page. Reduced motion turns the flip off.
 * The script must stay inline and in <head>: `pagereveal` fires before the first paint.
 */
---

<script is:inline>
	(function () {
		function side(url) {
			try {
				var p = new URL(url, location.href).pathname;
				return p === '/alice' || p.indexOf('/alice/') === 0 ? 'B' : 'A';
			} catch (e) {
				return null;
			}
		}
		function crosses(from, to) {
			if (!from || !to) return false;
			var a = side(from);
			var b = side(to);
			return a !== null && b !== null && a !== b;
		}
		var reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
		function noop() {}
		function skip(vt) {
			// A skipped transition rejects `ready`; catch it so the console stays clean.
			if (vt.ready) vt.ready.catch(noop);
			vt.skipTransition();
		}

		// On the page being left.
		window.addEventListener('pageswap', function (e) {
			if (!e.viewTransition) return;
			var to = e.activation && e.activation.entry ? e.activation.entry.url : null;
			if (reduce || !crosses(location.href, to)) skip(e.viewTransition);
		});

		// On the page being entered.
		window.addEventListener('pagereveal', function (e) {
			if (!e.viewTransition) return;
			var nav = window.navigation;
			var from = nav && nav.activation && nav.activation.from ? nav.activation.from.url : document.referrer;
			if (reduce || !crosses(from, location.href)) {
				skip(e.viewTransition);
				return;
			}
			var root = document.documentElement;
			root.classList.add('mirroring');
			if (e.viewTransition.ready) e.viewTransition.ready.catch(noop);
			e.viewTransition.finished.then(
				function () { root.classList.remove('mirroring'); },
				function () { root.classList.remove('mirroring'); }
			);
		});
	})();
</script>

<style is:global>
	@view-transition {
		navigation: auto;
	}
	@keyframes mirror-out {
		to {
			transform: perspective(1400px) rotateY(90deg);
			opacity: 0.55;
		}
	}
	@keyframes mirror-in {
		from {
			transform: perspective(1400px) rotateY(-90deg);
			opacity: 0.55;
		}
	}
	html.mirroring::view-transition {
		background: #0f1115;
	}
	html.mirroring::view-transition-old(root) {
		animation: mirror-out 260ms cubic-bezier(0.55, 0, 0.8, 0.3) both;
	}
	html.mirroring::view-transition-new(root) {
		animation: mirror-in 320ms 250ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
	}
	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(*),
		::view-transition-old(*),
		::view-transition-new(*) {
			animation: none !important;
		}
	}
</style>
