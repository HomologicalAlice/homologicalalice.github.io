---
/**
 * The B-side: Homological Alice, under /alice/.
 * Rotating wallpapers, a frosted card, and music. The A ⇄ B switch goes back to the academic side.
 */
import MirrorSwitch from '../components/MirrorSwitch.astro';
import MirrorTransition from '../components/MirrorTransition.astro';

interface Props {
	title?: string;
	description?: string;
	/** The matching page on the A-side, for the mirror switch. */
	mirror?: string;
	/** Language of the page content, e.g. 'zh-CN' for a post written in Chinese. */
	lang?: string;
	/** Load the KaTeX stylesheet (posts with math). */
	math?: boolean;
	ogType?: 'website' | 'article';
}
const {
	title,
	description = 'Homological Alice: the B-side of this site. Thoughts, and things outside mathematics.',
	mirror = '/',
	lang = 'en',
	math = false,
	ogType = 'website',
} = Astro.props;
const fullTitle = title ? `${title} | Homological Alice` : 'Homological Alice';
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
	{ href: '/alice/', label: 'Alice' },
	{ href: '/alice/thoughts/', label: 'Thoughts' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) =>
	here === href ? 'page' : href !== '/alice/' && here.startsWith(href) ? 'true' : undefined;
---

<!doctype html>
<html lang={lang} style="background:#1a1a2e">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Homological Alice" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="theme-color" content="#1a1a2e" />
		<link rel="preload" href="/images/alice1.avif" as="image" type="image/avif" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{/* Keep this version equal to node_modules/katex (the renderer used by rehype-katex). */}
		{math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.44/dist/katex.min.css" />}
		<meta name="generator" content={Astro.generator} />
		<MirrorTransition />
	</head>
	<body>
		<div id="wallpaper-a" class="wallpaper"></div>
		<div id="wallpaper-b" class="wallpaper"></div>
		<header>
			<nav aria-label="Main" lang="en">
				{nav.map(({ href, label }) => (
					<a href={href} aria-current={current(href)}>{label}</a>
				))}
			</nav>
			<MirrorSwitch side="B" href={mirror} />
		</header>
		<main>
			<slot />
		</main>
		<audio id="bgm" src="/audio/bgm.mp3" loop preload="none"></audio>
		<button id="bgm-btn" type="button" aria-pressed="false" lang="en">
			<span aria-hidden="true">&#9835;</span> <span class="lbl">Play music</span>
		</button>
		<script>
			const a = document.getElementById('wallpaper-a') as HTMLDivElement | null;
			const b = document.getElementById('wallpaper-b') as HTMLDivElement | null;
			if (a && b) {
				const wallpapers = [
					'/images/alice1.avif',
					'/images/alice2.avif',
					'/images/alice3.avif',
					'/images/alice4.avif',
					'/images/desktop-wallpaper.avif',
				];
				let i = 0;
				let showingA = true;

				const setLayer = (el: HTMLDivElement, url: string) => {
					el.style.backgroundImage = `url('${url}')`;
					const img = new Image();
					img.src = url;
				};

				const nextWallpaper = () => {
					document.body.style.backgroundImage = `url('${wallpapers[i]}')`;
					i = (i + 1) % wallpapers.length;
					const front = showingA ? a : b;
					const back = showingA ? b : a;
					back.style.transition = 'none';
					back.style.opacity = '0';
					setLayer(back, wallpapers[i]);
					void back.offsetWidth;
					back.style.transition = 'opacity 1.5s ease-in-out';
					back.style.opacity = '1';
					setTimeout(() => {
						front.style.opacity = '0';
					}, 100);
					showingA = !showingA;
				};

				setLayer(a, wallpapers[i]);
				a.style.opacity = '1';
				b.style.opacity = '0';

				// Rotate on a timer unless the visitor asked for reduced motion; clicking the background always works.
				const autoRotate = !matchMedia('(prefers-reduced-motion: reduce)').matches;
				let timer = autoRotate ? setInterval(nextWallpaper, 30_000) : undefined;
				document.addEventListener('click', (e) => {
					if ((e.target as HTMLElement).closest('a, button, main, header')) return;
					clearInterval(timer);
					nextWallpaper();
					if (autoRotate) timer = setInterval(nextWallpaper, 30_000);
				});
			}

			const audio = document.getElementById('bgm') as HTMLAudioElement | null;
			const btn = document.getElementById('bgm-btn');
			const lbl = btn?.querySelector('.lbl');
			if (audio && btn && lbl) {
				const updateBtn = () => {
					lbl.textContent = audio.paused ? 'Play music' : 'Pause music';
					btn.setAttribute('aria-pressed', String(!audio.paused));
				};
				updateBtn();
				btn.addEventListener('click', () => {
					if (audio.paused) {
						audio.play().then(updateBtn).catch(() => {});
					} else {
						audio.pause();
						updateBtn();
					}
				});
			}
		</script>
	</body>
</html>

<style is:global>
	html {
		min-height: 100%;
	}
	body {
		margin: 0;
		min-height: 100vh;
		font-family: system-ui, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
		background: url('/images/alice1.avif') center/cover no-repeat fixed;
		background-color: #1a1a2e;
	}
	.wallpaper {
		position: fixed;
		inset: 0;
		z-index: 1;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		opacity: 0;
		transition: opacity 1.5s ease-in-out;
		will-change: opacity;
	}
	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.3);
		z-index: 2;
		pointer-events: none;
	}
	header {
		position: relative;
		z-index: 3;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		padding: 1.25rem 1rem;
		--m-fg: rgba(255, 255, 255, 0.9);
		--m-bg: rgba(0, 0, 0, 0.3);
		--m-border: rgba(255, 255, 255, 0.5);
		--m-on-bg: #fff;
		--m-on-fg: #1a1a2e;
	}
	nav {
		display: flex;
		gap: 0.5rem 1.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	nav a {
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		font-size: 0.95rem;
		letter-spacing: 0.02em;
		padding: 0.15rem 0;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
	}
	nav a:hover,
	nav a[aria-current] {
		color: #fff;
	}
	nav a[aria-current] {
		box-shadow: inset 0 -2px 0 rgba(255, 255, 255, 0.85);
	}
	main {
		position: relative;
		z-index: 3;
		max-width: 38rem;
		margin: 2rem auto 3rem;
		padding: 2.5rem 2.5rem 3rem;
		background: rgba(255, 255, 255, 0.8);
		border-radius: 1rem;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}
	@media (max-width: 40rem) {
		main {
			margin: 1rem 1rem 3rem;
			padding: 1.75rem 1.25rem 2rem;
		}
	}
	main h1 {
		margin: 0 0 0.75rem;
		font-size: 1.75rem;
		font-weight: 600;
		color: #1a1a1a;
	}
	main h2 {
		margin: 2rem 0 0.75rem;
		font-size: 1.15rem;
		font-weight: 600;
		color: #1a1a1a;
	}
	main p {
		margin: 0;
		color: #444;
		line-height: 1.7;
	}
	main p + p {
		margin-top: 1em;
	}
	main a {
		color: #2563eb;
		text-decoration: none;
	}
	main a:hover {
		text-decoration: underline;
	}
	.ask-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1em;
	}
	.ask-row p {
		flex: 1 1 auto;
	}
	.ask-avatar {
		width: 5.5rem;
		height: 5.5rem;
		border-radius: 50%;
		object-fit: cover;
		object-position: center 15%;
		flex-shrink: 0;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
	}

	/* ---------- Thoughts: list ---------- */
	.thought-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.thought-list li {
		padding: 0.75rem 0;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
	}
	.thought-list li:last-child {
		border-bottom: none;
	}
	.thought-list a {
		font-size: 1.05rem;
		font-weight: 600;
		color: #1a1a1a;
	}
	.thought-list a:hover {
		color: #2563eb;
		text-decoration: none;
	}
	.thought-list .desc {
		margin: 0.15rem 0 0;
		font-size: 0.95rem;
	}
	.thought-list time,
	.thought-meta {
		display: block;
		font-size: 0.82rem;
		color: #6b7280;
		font-variant-numeric: tabular-nums;
	}
	.empty {
		color: #6b7280;
		font-style: italic;
	}

	/* ---------- Thoughts: a single post ---------- */
	.thought-meta {
		margin: -0.4rem 0 1.5rem;
	}
	.thought-body {
		color: #333;
		line-height: 1.8;
		overflow-wrap: break-word;
	}
	.thought-body p {
		margin: 0 0 1em;
		color: inherit;
		line-height: inherit;
	}
	.thought-body p + p {
		margin-top: 0;
	}
	.thought-body h2,
	.thought-body h3 {
		margin: 1.75rem 0 0.6rem;
		color: #1a1a1a;
	}
	.thought-body h3 {
		font-size: 1.02rem;
	}
	.thought-body ul,
	.thought-body ol {
		margin: 0 0 1em;
		padding-left: 1.5em;
	}
	.thought-body li {
		margin: 0.3em 0;
	}
	.thought-body blockquote {
		margin: 1.25em 0;
		padding: 0.5em 1em;
		border-left: 3px solid rgba(37, 99, 235, 0.5);
		background: rgba(255, 255, 255, 0.5);
		border-radius: 0 0.4rem 0.4rem 0;
		color: #555;
	}
	.thought-body blockquote p:last-child {
		margin-bottom: 0;
	}
	.thought-body img,
	.thought-body video {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.25rem auto;
		border-radius: 0.5rem;
	}
	.thought-body code {
		font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
		font-size: 0.88em;
		background: rgba(0, 0, 0, 0.06);
		padding: 0.1em 0.35em;
		border-radius: 0.25rem;
	}
	.thought-body pre {
		overflow-x: auto;
		padding: 0.9em 1em;
		background: rgba(0, 0, 0, 0.06);
		border-radius: 0.5rem;
	}
	.thought-body pre code {
		background: none;
		padding: 0;
	}
	.thought-body hr {
		margin: 2rem 0;
		border: none;
		border-top: 1px solid rgba(0, 0, 0, 0.12);
	}
	.thought-body .katex-display {
		overflow-x: auto;
		overflow-y: hidden;
		padding: 0.2em 0;
	}
	.back {
		margin-top: 2rem;
		font-size: 0.95rem;
	}

	#bgm-btn {
		position: fixed;
		bottom: 1.25rem;
		right: 1.25rem;
		z-index: 10;
		padding: 0.5rem 1rem;
		border: none;
		border-radius: 2rem;
		background: rgba(0, 0, 0, 0.55);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		color: #fff;
		font-size: 0.85rem;
		cursor: pointer;
		transition: background 0.2s;
	}
	#bgm-btn:hover {
		background: rgba(0, 0, 0, 0.7);
	}
	@media (prefers-reduced-motion: reduce) {
		.wallpaper {
			transition: none;
		}
	}
</style>
