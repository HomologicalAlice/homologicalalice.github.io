---
/**
 * The A-side: academic layout for Home, Research, Talks, Notes and CV.
 * The B-side (Homological Alice, under /alice/) uses AliceLayout.astro.
 * The A ⇄ B switch in the header goes to the matching page on the other side.
 */
import MirrorSwitch from '../components/MirrorSwitch.astro';
import MirrorTransition from '../components/MirrorTransition.astro';

interface Props {
	title?: string;
	description?: string;
	/** Load the KaTeX stylesheet (pages with math). */
	math?: boolean;
	/** Open Graph type: 'article' for posts. */
	ogType?: 'website' | 'article';
	/** The matching page on the B-side, for the mirror switch. */
	mirror?: string;
}

const DEFAULT_DESCRIPTION =
	'Tianyou Ma, mathematics Honours student at the Australian National University, working on Kirwan maps in symplectic topology.';

const {
	title,
	description = DEFAULT_DESCRIPTION,
	math = false,
	ogType = 'website',
	mirror = '/alice/',
} = Astro.props;
const fullTitle = title ? `${title} | Tianyou Ma` : 'Tianyou Ma';
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

const nav = [
	{ href: '/research/', label: 'Research' },
	{ href: '/talks/', label: 'Talks' },
	{ href: '/posts/', label: 'Notes' },
	{ href: '/cv/', label: 'CV' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
/** 'page' on the page itself, 'true' inside its section (a single post under Notes). */
const current = (href: string) =>
	here === href ? 'page' : href === '/posts/' && here.startsWith('/posts/') ? 'true' : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Tianyou Ma" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Tianyou Ma" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#14161a" media="(prefers-color-scheme: dark)" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
		/>
		{/* Keep this version equal to node_modules/katex (the renderer used by rehype-katex). */}
		{math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.44/dist/katex.min.css" />}
		<meta name="generator" content={Astro.generator} />
		<MirrorTransition />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<header class="site-header">
			<div class="wrap header-inner">
				<a class="site-name" href="/">Tianyou Ma</a>
				<div class="header-right">
					<nav aria-label="Main">
						{nav.map(({ href, label }) => (
							<a href={href} aria-current={current(href)}>{label}</a>
						))}
					</nav>
					<MirrorSwitch side="A" href={mirror} />
				</div>
			</div>
		</header>
		<main id="content" class="wrap">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap">
				<span>© {year} Tianyou Ma</span>
				<span aria-hidden="true">·</span>
				<a href="mailto:u7902950@anu.edu.au">u7902950@anu.edu.au</a>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fbfbf9;
		--ink: #1a1a1a;
		--ink-2: #3b4048;
		--muted: #6b7280;
		--hair: #e2e5ea;
		--accent: #1f3a5f;
		--link: #1f4f8f;
		--tint: rgba(31, 58, 95, 0.05);
		--code-bg: rgba(0, 0, 0, 0.05);
		--serif: 'Source Serif 4', 'Source Serif Pro', Georgia, 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
		--sans: system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
		--mono: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		--measure: 44rem;
		color-scheme: light;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #14161a;
			--ink: #e6e6e3;
			--ink-2: #c8ccd2;
			--muted: #9aa1ab;
			--hair: #2c3139;
			--accent: #a9c1e4;
			--link: #9cc0f0;
			--tint: rgba(169, 193, 228, 0.07);
			--code-bg: rgba(255, 255, 255, 0.08);
			color-scheme: dark;
		}
	}

	html {
		-webkit-text-size-adjust: 100%;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--serif);
		font-size: 1.0625rem;
		line-height: 1.65;
		text-rendering: optimizeLegibility;
	}
	.wrap {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 1.25rem;
	}

	.skip-link {
		position: absolute;
		left: -999px;
		top: 0.5rem;
		padding: 0.4rem 0.8rem;
		background: var(--accent);
		color: var(--bg);
		font-family: var(--sans);
		font-size: 0.9rem;
		z-index: 10;
	}
	.skip-link:focus {
		left: 0.5rem;
	}

	/* ---------- Header ---------- */
	.site-header {
		border-bottom: 1px solid var(--hair);
		font-family: var(--sans);
	}
	.header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.4rem 1.5rem;
		padding-top: 1.1rem;
		padding-bottom: 0.9rem;
	}
	.site-name {
		font-family: var(--serif);
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}
	.header-right {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 1.1rem;
		--m-fg: var(--muted);
		--m-border: var(--hair);
		--m-on-bg: var(--accent);
		--m-on-fg: var(--bg);
	}
	.site-header nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 1.1rem;
		font-size: 0.95rem;
	}
	.site-header nav a {
		color: var(--muted);
		text-decoration: none;
		padding: 0.15rem 0;
	}
	.site-header nav a:hover {
		color: var(--ink);
	}
	.site-header nav a[aria-current] {
		color: var(--ink);
		box-shadow: inset 0 -2px 0 var(--accent);
	}

	/* ---------- Main ---------- */
	main.wrap {
		padding-top: 2.5rem;
		padding-bottom: 4rem;
	}
	main h1 {
		margin: 0 0 0.35rem;
		font-size: 2rem;
		line-height: 1.2;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	main p {
		margin: 0 0 1rem;
	}
	main a {
		color: var(--link);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
		text-decoration-color: color-mix(in srgb, var(--link) 35%, transparent);
	}
	main a:hover {
		text-decoration-color: currentColor;
	}
	main strong {
		font-weight: 600;
	}
	.lede {
		font-family: var(--sans);
		font-size: 0.98rem;
		color: var(--muted);
		margin: 0 0 1.25rem;
	}
	.quick-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.6rem;
		font-family: var(--sans);
		font-size: 0.95rem;
		margin: 0 0 2rem;
	}
	.quick-links .sep {
		color: var(--muted);
	}
	.aside {
		color: var(--muted);
		font-size: 0.95rem;
	}

	/* Section headings on the academic pages echo the CV: small caps, hairline. */
	.page h2 {
		margin: 2.5rem 0 1rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--hair);
		font-family: var(--sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.page h3 {
		margin: 1.75rem 0 0.5rem;
		font-size: 1.05rem;
		font-weight: 600;
	}
	.page ul {
		margin: 0 0 1rem;
		padding-left: 1.2rem;
	}
	.page li {
		margin: 0.45rem 0;
	}
	.page ol {
		margin: 0 0 1rem;
		padding-left: 1.6rem;
	}

	/* Dated entries: <ul class="entries"> with <span class="date"> first. */
	.page ul.entries {
		list-style: none;
		padding: 0;
	}
	/* Fallback (also the phone layout): the date sits on its own line above the entry. */
	.page .date {
		display: block;
		font-family: var(--sans);
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	@supports selector(:has(> *)) {
		.page ul:has(> li > .date) {
			list-style: none;
			padding: 0;
		}
		@media (min-width: 34.01rem) {
			.page li:has(> .date) {
				position: relative;
				padding-left: 10rem;
			}
			.page li:has(> .date) > .date {
				position: absolute;
				left: 0;
				top: 0.2em;
				width: 9.5rem;
			}
		}
	}
	.work-title {
		font-size: 1.12rem;
		font-weight: 600;
		margin: 0 0 0.2rem;
	}
	.work-meta {
		font-family: var(--sans);
		font-size: 0.9rem;
		color: var(--muted);
		margin: 0 0 0.9rem;
	}
	.note {
		padding: 0.75rem 1rem;
		background: var(--tint);
		border-left: 3px solid var(--accent);
		border-radius: 0 0.3rem 0.3rem 0;
		font-size: 0.97rem;
	}

	/* ---------- Footer ---------- */
	.site-footer {
		border-top: 1px solid var(--hair);
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--muted);
	}
	.site-footer .wrap {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		padding-top: 1.25rem;
		padding-bottom: 2rem;
	}
	.site-footer a {
		color: var(--muted);
	}

	/* ---------- Math ---------- */
	main .katex {
		font-size: 1.04em;
	}
	main .katex-display {
		margin: 1.1em 0;
		overflow-x: auto;
		overflow-y: hidden;
		padding: 0.2em 0;
	}
	main .katex-display > .katex {
		white-space: nowrap;
	}

	/* ---------- Notes list ---------- */
	.page ul.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--hair);
	}
	.post-list li:last-child {
		border-bottom: none;
	}
	.post-list a {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}
	.post-list a:hover {
		color: var(--link);
	}
	.post-list .desc {
		margin: 0.2rem 0 0.15rem;
		color: var(--ink-2);
		font-size: 0.97rem;
	}
	.post-list .dates {
		display: block;
		font-family: var(--sans);
		font-size: 0.82rem;
		color: var(--muted);
	}

	/* ---------- Single post ---------- */
	.post .toolbar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		margin: 0.5rem 0 2rem;
		padding-bottom: 0.9rem;
		border-bottom: 1px solid var(--hair);
		font-family: var(--sans);
	}
	.post .meta {
		font-size: 0.9rem;
		color: var(--muted);
		line-height: 1.55;
	}
	.post .meta .author {
		display: block;
		color: var(--ink-2);
		font-weight: 500;
	}
	.zoom-ctrl {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--hair);
		border-radius: 999px;
		padding: 0.1rem 0.2rem;
		user-select: none;
	}
	.zoom-ctrl button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	.zoom-ctrl button:hover:not(:disabled) {
		background: var(--code-bg);
		color: var(--ink);
	}
	.zoom-ctrl button:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.zoom-ctrl span {
		min-width: 2.8em;
		text-align: center;
		font-size: 0.75rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.post .body h2 {
		margin: 2.25rem 0 0.75rem;
		padding-bottom: 0.3rem;
		font-size: 1.4rem;
		font-weight: 600;
		border-bottom: 1px solid var(--hair);
	}
	.post .body h3 {
		margin: 1.6rem 0 0.5rem;
		font-size: 1.15rem;
		font-weight: 600;
	}
	.post .body p {
		line-height: 1.75;
		overflow-wrap: break-word;
	}
	@media (min-width: 40rem) {
		.post .body p {
			text-align: justify;
			hyphens: auto;
		}
	}
	.post .body ul,
	.post .body ol {
		margin: 0.75em 0;
		padding-left: 1.5em;
	}
	.post .body li {
		margin: 0.3em 0;
	}
	.post .body li p {
		margin: 0;
	}
	/* Theorem / definition blocks are written as blockquotes. */
	.post .body blockquote {
		margin: 1.25em 0;
		padding: 0.9em 1.1em;
		border-left: 3px solid var(--accent);
		background: var(--tint);
		border-radius: 0 0.35rem 0.35rem 0;
	}
	.post .body blockquote p {
		margin: 0;
	}
	.post .body blockquote p + p {
		margin-top: 0.6em;
	}
	.post .body blockquote .katex-display {
		margin: 0.75em 0;
	}
	.post .body table {
		width: 100%;
		border-collapse: collapse;
		margin: 1em 0;
		font-size: 0.93rem;
		display: block;
		overflow-x: auto;
	}
	.post .body th,
	.post .body td {
		padding: 0.45em 0.7em;
		border: 1px solid var(--hair);
		text-align: left;
	}
	.post .body th {
		background: var(--code-bg);
		font-weight: 600;
	}
	.post .body code {
		font-family: var(--mono);
		font-size: 0.86em;
		background: var(--code-bg);
		padding: 0.12em 0.35em;
		border-radius: 0.25rem;
	}
	.post .body pre {
		margin: 1em 0;
		padding: 1em;
		overflow-x: auto;
		background: var(--code-bg);
		border-radius: 0.4rem;
	}
	.post .body pre code {
		background: none;
		padding: 0;
	}
	.post .body hr {
		margin: 2rem 0;
		border: none;
		border-top: 1px solid var(--hair);
	}
	.post .body figure {
		margin: 1.25rem 0;
	}
	.post .body img {
		display: block;
		max-width: min(100%, 26rem);
		height: auto;
		margin: 1.25rem auto;
	}
	@media (prefers-color-scheme: dark) {
		/* Charts are drawn black on transparent; give them a light card. */
		.post .body img {
			background: #fff;
			padding: 0.5rem;
			border-radius: 0.3rem;
		}
	}
	.post .back {
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--hair);
		font-family: var(--sans);
		font-size: 0.95rem;
	}
</style>
