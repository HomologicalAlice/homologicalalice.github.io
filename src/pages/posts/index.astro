---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const dateOpts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
const fmt = (d: Date) => d.toLocaleDateString('en-AU', dateOpts);

const posts = (await getCollection('blog')).sort(
	(a, b) =>
		(b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf(),
);
---

<Layout title="Notes" description="Notes and write-ups by Tianyou Ma.">
	<article class="page">
		<h1>Notes</h1>
		<p class="lede">
			Longer write-ups. From time to time I may also post notes on homological mirror symmetry and
			geometric invariant theory here.
		</p>
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a href={`/posts/${post.id}/`}>{post.data.title}</a>
					{post.data.description && <p class="desc">{post.data.description}</p>}
					<span class="dates">
						{fmt(post.data.pubDate)}
						{post.data.updatedDate && <> · edited {fmt(post.data.updatedDate)}</>}
					</span>
				</li>
			))}
		</ul>
	</article>
</Layout>
